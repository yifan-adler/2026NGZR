 /**====================== 原子动作 =========================== */
+void RDFW::ClearContainerMembership(const shared_ptr<SmallObject>& small) {
+    if (!small) return;
+    for (const auto& object : objects) {
+        auto container = dynamic_pointer_cast<Container>(object);
+        if (!container) continue;
+        auto& items = container->smallObjectsInside;
+        items.erase(std::remove_if(items.begin(), items.end(),
+            [&](const shared_ptr<SmallObject>& item) {
+                return item && item->id == small->id;
+            }), items.end());
+    }
+}
+
+void RDFW::ReconcileLocationRelation(const shared_ptr<SmallObject>& small) {
+    if (!small || small->inside <= 0) return;
+    auto container = dynamic_pointer_cast<Container>(GetObject(small->inside));
+    if (container && container->location != UNKNOWN && small->location != UNKNOWN &&
+        container->location != small->location) {
+        ClearContainerMembership(small);
+        small->inside = UNKNOWN;
+        SetInsideEvidence(small->id, false, EvidenceSource::EXPLICIT_INFO);
+    }
+}
+
+// A successful container action proves co-location even when the initial
+// location was misleading. Its contents inherit that location only with the
+// strength of their own inside evidence.
+void RDFW::ConfirmContainerLocation(const shared_ptr<Container>& container) {
+    if (container->location != location)
+        InvalidateSenseAtLocation(container->location);
+    container->location = location;
+    MarkDirectLocationEvidence(container->id, true);
+    for (const auto& item : container->smallObjectsInside) {
+        if (!item || item->inside != container->id) continue;
+        if (IsLocationVerified(item->id) && !IsInsideVerified(item->id) &&
+            item->location != location) continue;
+        item->location = location;
+        const bool inside_verified = IsInsideVerified(item->id);
+        // The action verifies the container, not an inside relation that was
+        // inferred from a constraint. Preserve that dependency for terminal
+        // checking if the supporting constraint later loses eligibility.
+        const EvidenceSource source = inside_verified &&
+            InsideSource(item->id) == EvidenceSource::CONSTRAINT_DERIVED
+                ? EvidenceSource::CONSTRAINT_DERIVED
+                : EvidenceSource::ACTION_SUCCESS;
+        MarkDirectLocationEvidence(item->id, inside_verified, source);
+    }
+}
